# Per-reviewer SIP account configuration.
#
# Copy this file to scripts/.env and replace each USER name with the
# username portion of a SIP account you've registered at
# https://subscribe.linphone.org/register/email .
#
# The harness scripts in this directory require scripts/.env and build full SIP URIs of the form
# sip:${SIP_SENDER_USER}@${SIP_DOMAIN} etc. — so no username is hardcoded
# anywhere outside this file.
#
# Roles:
#   SENDER  — the source of the conference (Mac CLI). The DYLD attack
#             hook is injected into this process.
#   FOCUS   — the conference focus daemon (Mac CLI). MUST be signed
#             out of every phone, otherwise SIP forking hijacks the
#             INVITE.
#   RECV_A  — receiver A on the Android Linphone app. The EKT_NOTIFY
#             blocklist is keyed to this username, so this is the
#             account that gets stuck on the pre-rotation key.
#   RECV_B  — receiver B on the iOS Linphone app. The "control" — sees
#             the post-rotation key.

SIP_SENDER_USER="<sender-user>"
SIP_FOCUS_USER="<focus-user>"
SIP_RECV_A_USER="<receiver-a-user>"
SIP_RECV_B_USER="<receiver-b-user>"
SIP_DOMAIN="sip.linphone.org"
